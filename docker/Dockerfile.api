FROM python:3.12.14-slim-trixie AS base
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
WORKDIR /build
COPY requirements-serve.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-compile -r requirements-serve.txt

FROM base AS runtime
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/lukasja111/mlops-u1" \
      org.opencontainers.image.revision="$GIT_COMMIT"
ENV PATH="/opt/venv/bin:$PATH" \
    GIT_PYTHON_REFRESH=quiet \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY src/features.py src/serve.py ./src/
RUN useradd --create-home --uid 1000 mluser
USER mluser
EXPOSE 8000
CMD ["uvicorn", "serve:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
